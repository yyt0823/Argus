<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.argus.agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>__ROOT__/.venv/bin/python</string>
        <string>-m</string>
        <string>argus.main</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__ROOT__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__ROOT__/logs/launchd.out</string>
    <key>StandardErrorPath</key>
    <string>__ROOT__/logs/launchd.err</string>
</dict>
</plist>
